# ── Database (Supabase Postgres) ────────────────────────────────────────────
#
# DATABASE_URL must be the CONNECTION POOLER URL (port 6543), not the direct
# connection. Vercel runs each request in a short-lived serverless function,
# and direct connections exhaust Postgres' connection limit almost immediately.
# Supabase's direct host (db.<ref>.supabase.co:5432) is also IPv6-only on newer
# projects, which serverless functions frequently cannot reach at all.
#
# Find both strings in Supabase: Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL is the direct connection (port 5432). Prisma uses it only for
# migrations, which need a real session the pooler can't provide.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── NextAuth ────────────────────────────────────────────────────────────────
#
# Local: http://localhost:3000  (no trailing slash)
# Vercel: leave this UNSET, or set it to https://mock-view-six.vercel.app
# Never copy localhost into Vercel — Google would redirect to your laptop.
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
# Required in production - NextAuth refuses to start without it.
# Add the same value in Vercel → Project Settings → Environment Variables.
NEXTAUTH_SECRET=""

# Google sign-in (OAuth 2.0 Web application client).
# Local redirect:  http://localhost:3000/api/auth/callback/google
# Vercel: add GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET in Vercel env (Production)
# and in Google Cloud Console → Credentials → your OAuth client:
#   Authorized JavaScript origins:
#     http://localhost:3000
#     https://mock-view-six.vercel.app
#   Authorized redirect URIs:
#     http://localhost:3000/api/auth/callback/google
#     https://mock-view-six.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── AI (Google Gemini) ──────────────────────────────────────────────────────
#
# Used for interview generation, evaluation, and resume ATS analysis.
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# ── Redis (optional) ────────────────────────────────────────────────────────
#
# Cache-aside for dashboard payloads and shared AI rate-limit counters.
# If unset or unreachable, the app falls back to an in-process TTL map.
# Local: redis://127.0.0.1:6379
# Production: use a managed Redis URL (Upstash, Redis Cloud, etc.)
REDIS_URL=""

# ── AI rate limits (optional) ───────────────────────────────────────────────
#
# Per authenticated user, plus a looser per-IP cap. Applied to Gemini routes:
# generate, evaluate, suggest, STAR rewrite, resume analyze.
AI_RATE_LIMIT_PER_MINUTE="20"
AI_RATE_LIMIT_PER_HOUR="80"
AI_RATE_LIMIT_IP_PER_MINUTE="40"
